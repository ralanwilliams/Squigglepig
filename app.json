{
  "expo": {
    "name": "Squigglepig",
    "slug": "squigglepig",
    "version": "2.0.0",
    "orientation": "default",
    "scheme": "squigglepig",
    "icon": "./src/assets/images/logo-512X512.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#4ECDC4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squigglepig.app"
    },
    "android": {
      "package": "com.squigglepig.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4ECDC4",
        "foregroundImage": "./src/assets/images/logo-512X512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/images/logo-192X192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo-512X512.png",
          "resizeMode": "contain",
          "backgroundColor": "#4ECDC4",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ]
  }
}
