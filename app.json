{
  "expo": {
    "name": "Squigglepig",
    "slug": "squigglepig",
    "version": "2.9.0",
    "orientation": "default",
    "scheme": "squigglepig",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#4ECDC4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squigglepig.app",
      "associatedDomains": [
        "applinks:squigglepig.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.squigglepig.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4EC4C4",
        "foregroundImage": "./src/assets/images/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "squigglepig.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/images/logo-192X192.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#4ECDC4",
          "android": {
            "image": "./src/assets/images/splash-android.png",
            "imageWidth": 192
          },
          "ios": {
            "image": "./src/assets/images/squigglepig_clear_dark.png",
            "imageWidth": 320
          }
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#4ECDC4"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9768dd83-627d-4a09-8aa3-809cce81beb5"
      }
    }
  }
}
