# Cloudflare Pages response headers for play.squigglepig.app, the web build of
# the game (https://developers.cloudflare.com/pages/configuration/headers/).
# expo export copies public/ into dist/. squigglepig.app has its own, site/_headers.

# Room codes ride in the /join query string; don't pass them on to any other
# site a player clicks through to, and keep invite URLs out of search.
/*
  Referrer-Policy: no-referrer
/join*
  X-Robots-Tag: noindex

/manifest.webmanifest
  Content-Type: application/manifest+json

# The bundle and assets have a content hash in their file names, so a given URL
# never changes and browsers can keep it. index.html isn't covered, so a new
# deploy is picked up on the next visit.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
