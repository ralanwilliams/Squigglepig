# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# When iOS is added, .well-known/apple-app-site-association has no extension and
# needs an explicit JSON content type here too.

/.well-known/assetlinks.json
  Content-Type: application/json

# Room codes ride in the /join query string; don't pass them on to the store or
# any other site a visitor clicks through to, and keep invite pages out of search.
/*
  Referrer-Policy: no-referrer
/join*
  X-Robots-Tag: noindex
